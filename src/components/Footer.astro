---
import { DEFAULT_LOCALE, t } from '@/i18n';
import { getSiteContext, sourceRepoUrl } from '@/lib/site';

const locale = DEFAULT_LOCALE;
const site = getSiteContext();
---

<footer
  class="border-t border-slate-200 py-6 text-center text-sm text-slate-500 dark:border-slate-800 dark:text-slate-400"
>
  {site.mainSite && (
    <>
      <a href={site.mainSite} target="_blank" rel="noopener">
        Powered by {site.poweredBy}
      </a>
      <span> | </span>
    </>
  )}
  {!site.mainSite && <span>Powered by {site.poweredBy}</span>}
  <a href={sourceRepoUrl()} target="_blank" rel="noopener" data-i18n="detail.sourceRepo">
    {t(locale, 'detail.sourceRepo')}
  </a>
</footer>
